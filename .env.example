# Documentation only. Run pnpm db:up; do not copy this template to .env.
# The helper creates an ignored .env with a random password and volume suffix.
# Existing .env files are preserved; configure all three values consistently.
# DATABASE_URL must target replaykit on 127.0.0.1:55432, with the same password.
POSTGRES_PASSWORD=<generated-locally>
DATABASE_URL=postgres://replaykit:<generated-locally>@127.0.0.1:55432/replaykit
REPLAYKIT_DEV_VOLUME=<generated-locally>
