{
  "name": "replaykit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:sdk": "node --import tsx --test scripts/sdk-protocol.test.ts",
    "test:security": "tsx scripts/security-smoke.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "replaykit": "tsx packages/cli/src/index.ts",
    "benchmark": "tsx packages/cli/src/index.ts benchmark",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "sandbox:build": "tsx scripts/build-sandbox.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "~0.213.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "~3.2.7"
  }
}
